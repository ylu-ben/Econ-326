```
parks<-read_csv2('parks-polygon-representation.csv')|>
select(`Park Name`, geo_point_2d)|>
separate(col = geo_point_2d, into = c('Longitude', 'Latitude'), sep = ',', convert = TRUE, remove = TRUE)|>
rename(park_name = `Park Name`)
head(parks)
sf_use_s2(TRUE)
housing_sf <- st_as_sf(housing, coords = c("Longitude", "Latitude"), crs = 4326, remove = FALSE)
parks_sf <- st_as_sf(parks, coords = c("Longitude", "Latitude"), crs = 4326, remove = FALSE)
nearest <- st_nearest_feature(housing_sf, parks_sf)
distance <- st_distance(housing_sf,
parks_sf[nearest, ],
by_element = TRUE)
result <- housing
result$nearest_park <- parks_sf$park_name[nearest]
result$distance <- as.numeric(units::set_units(distance, 'm'))
head(result)
View(result)
View(parks)
